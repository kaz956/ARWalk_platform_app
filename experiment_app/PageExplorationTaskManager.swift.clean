            .init(id: "black",        title: "黒",             body: "夜の暗闇やカラスの羽、炭などの色です。落ち着いていて、強いイメージを与えます。",                                                                                             links: ["色","夜","宇宙","影"]),
            .init(id: "shadow",       title: "影",             body: "
