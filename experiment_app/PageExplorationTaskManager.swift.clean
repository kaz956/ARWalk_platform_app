            .init(id: "autumn",       title: "秋",             body: "夏が終わって涼しくなってくる季節です。木の葉っぱが赤や黄色になり、果物や野菜が美味しく実ります。",                                                                           links: ["自然","季節","木の葉","果物","お月見"]),
            .init(id: "festival",     title: "祭り",           body: "街のみんなで集まってお祝いをする行事です。屋台が出たり、踊ったりして、とても賑やかで楽しい時間です。",                                                                       links: ["街","生活","文化","遊び","笑顔"]),
            .init(id: "news",         title: "ニュース",       body: "今世界や街で何が起きているかを教えてくれる
報のことです。テレビや新聞、インターネットで知ることができます。",                                                             links: ["街","社会","テレビ","インターネット"]),
            .init(id: "tv",           title: "テレビ",         body: "映像と音でニュースやアニメ、ドラマを見ることができる道
