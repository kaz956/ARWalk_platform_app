    func configure(eventLogger: @escaping (TaskEventPayload) -> Void) {
        self.eventLogger = eventLogger
    }

    func start() {
        isRunning = true
        currentChallenge = nil
        nextChallengeDate = Date()
    }

    func stop() {
        isRunning = false
        currentChallenge = nil
        nextChallengeDate = nil
    }

    func pause() {
        isRunning = false
    }

    func resume() {
        isRunning = true
        if nextChallengeDate == nil {
            nextChallengeDate = Date()
        }
    }

    @discardableResult
    func update(now: Date, elapsedTime: TimeInterval) -> Bool {
        var changed = false

        if let challenge = currentChallenge, challenge.expiresAt <= now {
            eventLogger?(
                TaskEventPayload(
                    elapsedTime: elapsedTime,
                    eventType: "page_miss",
                    taskType: .pageExplore,
                    rule: "リンクを辿って目標ページへ到達",
                    isCorrect: "false",
                    detail1: challenge.currentPage.title,
                    detail2: challenge.targetTitle
                )
            )
            currentChallenge = nil
            lastResult = false
            nextChallengeDate = now.addingTimeInterval(1.0)
            changed = true
        }

        guard isRunning else { return changed }
        guard currentChallenge == nil else { return changed }
        guard let nextChallengeDate, now >= nextChallengeDate else { return changed }

        startNewChallenge(now: now)
        return true
    }

    private func startNewChallenge(now: Date) {
        let keys = Array(pages.keys)
        guard keys.count >= 2 else { return }
        let startKey = keys.randomElement()!
        var targetKey = keys.randomElement()!
        while targetKey == startKey { targetKey = keys.randomElement()! }

        lastResult = nil
        scrollLine = 0
        currentChallenge = PageExplorationChallenge(
            targetTitle: targetKey,
            currentPage: pages[startKey]!,
            spawnedAt: now,
            expiresAt: now.addingTimeInterval(timeLimit)
        )

        eventLogger?(
            TaskEventPayload(
                elapsedTime: 0,
                eventType: "page_start",
                taskType: .pageExplore,
                rule: "リンクを辿って目標ページへ到達",
                detail1: startKey,
                detail2: targetKey
            )
        )
    }

    @discardableResult
    func handleTap(targetID: String, elapsedTime: TimeInterval) -> Bool {
        if targetID == "Explore.ScrollUp" {
            scrollLine = max(0, scrollLine - 1)
            return true
        } else if targetID == "Explore.ScrollDown" {
            scrollLine += 1
            return true
        }

        guard let challenge = currentChallenge else { return false }
        guard targetID.hasPrefix("PageLink.") else { return false }

        let linkTitle = targetID.replacingOccurrences(of: "PageLink.", with: "").replacingOccurrences(of: "_", with: " ")

        if linkTitle == challenge.targetTitle {
            eventLogger?(
                TaskEventPayload(
                    elapsedTime: elapsedTime,
                    eventType: "page_success",
                    taskType: .pageExplore,
                    rule: "リンクを辿って目標ページへ到達",
                    isCorrect: "true",
                    reactionTime: Date().timeIntervalSince(challenge.spawnedAt),
                    detail1: challenge.currentPage.title,
                    detail2: challenge.targetTitle
                )
            )
            currentChallenge = nil
            lastResult = true
            nextChallengeDate = Date().addingTimeInterval(1.0)
            return true
        }

        if let nextPage = pages[linkTitle] {
            eventLogger?(
                TaskEventPayload(
                    elapsedTime: elapsedTime,
                    eventType: "page_navigate",
                    taskType: .pageExplore,
                    rule: "リンクを辿って目標ページへ到達",
                    isCorrect: "false",
                    detail1: challenge.currentPage.title,
                    detail2: linkTitle
                )
            )
            scrollLine = 0
            currentChallenge = PageExplorationChallenge(
                targetTitle: challenge.targetTitle,
                currentPage: nextPage,
                spawnedAt: challenge.spawnedAt,
                expiresAt: challenge.expiresAt
            )
        }

        return true
    }
}
