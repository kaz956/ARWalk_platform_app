        ]による自動車や航空機の発展が地球規模の交流を可能にし、経済や環境に大きな影響を与えています。",                                                               links: ["社会","科学","地球","経済学","環境","エネルギー"]),
            .init(id: "education",    title: "教育",           body: "教育は知識や価値観を次世代に伝える社会的な営みです。人類の歴史において文明の発展を支える中心的な役割を果たし、心理学や社会学の重要な研究対象でもあります。",                                               links: ["社会","人類","歴史","心理学","社会学","言語"]),
            .init(id: "space_exp",    title: "宇宙探査",       body: "宇宙探査はロケットや探査機を用いて天体を直接調査する科学活動です。太陽系や宇宙の起源を探る人類の挑戦であり、高度なコンピュータ技術と物理学の結晶です。",                                                     links: ["宇宙","太陽系","科学","人類","物理学","コンピュータ"]),
            .init(id: "mars",         title: "火星",           body: "火星は太陽系で地球のすぐ外側を回る惑星です。かつて水が存在した痕跡があり、生命の可能性や人類の移住
として科学的な関心が非常に高い天体です。",                                                               links: ["太陽系","地球","宇宙","科学","水","火山"]),
            .init(id: "moon",         title: "月",             body: "月は地球の唯一の自然衛星です。人類が到達した唯一の天体であり、歴史や文化、潮汐などの環境現象に多大な影響を与えてきました。天文学の基本となる存在です。",                                                       links: ["地球","太陽系","宇宙","歴史","文化","天文学"]),
            .init(id: "volcano",      title: "火山",           body: "火山は地殻の下にあるマグマが地表に噴出する場所です。地球のエネルギーを象徴し、山岳地帯を形成するとともに気象や環境にも大きな影響を及ぼします。",                                                               links: ["地球","エネルギー","山岳","気象","環境","地理学"]),
            .init(id: "desert",       title: "砂漠",           body: "砂漠は降水量が極端に少なく乾燥した地域です。過
な環境に適応した独特の動物や植物が生息し、地球の地理学や気候変動の研究において重要な役割を占めています。",                                                   links: ["地球","環境","地理学","植物","動物","気象"]),
            .init(id: "forest",       title: "森林",           body: "森林は多くの樹木が密生する地域で、地球の「肺」として
素を供給します。多様な生物の住処となり、水資源の涵養や環境維持に不可欠な役割を
っています。",                                                       links: ["地球","環境","植物","動物","水","気候"]),
            .init(id: "coral",        title: "サンゴ礁",       body: "サンゴ礁は「海の熱帯雨林」と呼ばれるほど豊かな生物多様性を持つ海洋生
系です。地球の環境変化に敏感であり、海洋学や生
学の重要な研究拠点です。",                                                             links: ["海洋","地球","環境","動物","科学","生
学"]),
            .init(id: "fossil",       title: "化石",           body: "化石は地層に残された古代生物の遺骸や痕跡です。進化の歴史を解明する重要な証拠であり、地球の過去の状
を知るための科学的な鍵となります。考古学とも関連します。",                                               links: ["進化","地球","歴史","科学","考古学","動物","植物"]),
            .init(id: "dinosaur",     title: "恐竜",           body: "恐竜は中生代に地球上で繁栄した巨大な爬虫類の仲間です。化石の研究からその多様な姿や進化の過程が明らかになり、文化や科学への好奇心を刺激し続けています。",                                                     links: ["動物","化石","歴史","科学","進化","地球"]),
            .init(id: "deep_sea",     title: "深海",           body: "深海は水深200m以上の
が届かない海洋領域です。
高圧・低温の極限環境であり、未知の動物や地球
部の熱源など、科学的に多くの謎が残されています。",                                                               links: ["海洋","地球","科学","水","動物","エネルギー"]),
            .init(id: "city",         title: "都市",           body: "都市は人口が密集し社会・経済活動の中心となる場所です。建築技術や交通網が高度に発達し、歴史や文化の発信地として人類の生活を形作ってきました。",                                                               links: ["社会","経済学","建築","交通","歴史","文化","人類"]),
            .init(id: "money",        title: "貨幣",           body: "貨幣は交換手段や価値の尺度として機能する社会的な発明品です。歴史の中で貝殻から金属、紙幣、そしてデジタルへと進化し、世界経済の根幹を支えています。",                                                         links: ["経済学","社会","歴史","文化","コンピュータ"]),
            .init(id: "religion",     title: "宗教",           body: "宗教は
越的な存在や価値観を
有する人類の精神文化です。歴史や社会構造に深く根ざし、芸術や建築、哲学の発展に多大な影響を与えてきました。",                                                               links: ["文化","歴史","社会","哲学","芸術","建築"]),
            .init(id: "mythology",    title: "神話",           body: "神話は世界の起源や神
の物語を伝える文化遺産です。言語や文学の源泉となり、心理学的な象徴としても分析されます。人類の想像力の豊かさを示しています。",                                                       links: ["文化","文学","言語","歴史","心理学","宗教"]),
            .init(id: "theatre",      title: "演劇",           body: "演劇は俳優が舞台上で物語を実演する芸術形式です。古代から続く歴史があり、文学や音楽、美術などが融合した総合文化として社会に親しまれてきました。",                                                             links: ["芸術","文学","文化","歴史","社会","音楽"]),
            .init(id: "animation",    title: "アニメーション", body: "アニメーションは静止画を連続させることで動きを生み出す映像表現です。コンピュータ技術の進歩で表現が飛躍し、現代の文化やインターネットにおいて重要な地位を占めています。",                                     links: ["芸術","文化","インターネット","コンピュータ","映画","漫画"]),
            .init(id: "manga",        title: "漫画",           body: "漫画は絵と文字を組み合わせて物語を表現する文化形式です。独自の文法を持ち、歴史的な絵巻物から現代の電子書籍まで、社会に広く浸透している表現手段です。",                                                       links: ["文化","芸術","文学","歴史","社会","アニメーション"]),
            .init(id: "game",         title: "ゲーム",         body: "ゲームはルールに従って目標達成を目指す遊びや競技です。スポーツからコンピュータゲームまで多様化し、社会的な交流や脳の活性化、文化的な楽しみを提供します。",                                                   links: ["文化","社会","コンピュータ","脳","スポーツ","数学"]),
            .init(id: "cryptography", title: "暗号技術",       body: "暗号技術は
報を秘匿し安
に伝えるための数学的な手法です。インターネットのセキュリティを支える科学の要であり、コンピュータと数学の密接な関係を象徴しています。",                                               links: ["コンピュータ","数学","インターネット","科学","社会"]),
            .init(id: "nano",         title: "ナノテクノロジー", body: "ナノテクノロジーは原子や分子のレベルで物質を制御する最
端の科学技術です。医学やエネルギー、素材開発など、人類の未来社会を大きく変える可能性を秘めています。",                                             links: ["科学","医学","物理学","エネルギー","工業","コンピュータ"]),
            .init(id: "biotech",      title: "バイオテクノロジー", body: "バイオテクノロジーは生物の機能を活用して社会に役立てる技術です。遺伝子操作を用いた医学や農業の革新、環境浄化など、地球規模の課題解決に貢献しています。",                                             links: ["科学","生物","遺伝子","医学","農業","環境"]),
            .init(id: "industrial",   title: "工業",           body: "工業は原材料を加工して製品を製造する経済活動です。産業革命以来、歴史と社会を劇的に変貌させ、エネルギーや科学技術の発展を牽引してきました。",                                                                 links: ["経済学","歴史","社会","エネルギー","科学","交通"]),
            .init(id: "biol",         title: "生物",           body: "生物は生命活動を行う存在の総称です。動物・植物から微生物まで地球上の多様な環境に適応しており、進化や生
学の研究対象となります。医学や農業の基礎です。",                                                       links: ["地球","環境","動物","植物","進化","生
学","医学","農業"]),
            .init(id: "math",         title: "数学",           body: "数学は数、量、形などの構造を論理的に探求する学問です。科学や物理学の言語として機能し、コンピュータのアルゴリズムやインターネットの暗号技術にも不可欠な存在です。",                                           links: ["科学","物理学","コンピュータ","哲学","言語","AI"]),
