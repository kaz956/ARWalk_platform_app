            .init(id: "sweet",        title: "甘い",           body: "砂糖や果物のような味がすることです。お菓子やケーキを食べた時に感じる、幸せな味です。",                                                                                     links: ["食べ物","お菓子","果物","砂糖"]),
            .init(id: "sugar",        title: "砂糖",           body: "甘い味をつけるための白い粉です。植物から作られ、お菓子や料理に使われます。",                                                                                                 links: ["料理","お菓子","甘い","植物"]),
            .init(id: "salt",         title: "塩",             body: "料理にしょっぱい味をつける白い粒です。海の水から作られ、食べ物の味を引き立てます。",                                                                                         links: ["料理","海","水","白"]),
            .init(id: "soup",         title: "スープ",         body: "野菜や肉を
