            .init(id: "colors",       title: "色",             body: "赤、青、黄色、緑など、物が持っている見た目の特徴です。花や服、おもちゃなど、世界にはたくさんの色が溢れています。",                                                           links: ["自然","生活","花","服","おもちゃ"]),
            .init(id: "red",          title: "赤",             body: "リンゴやトマト、郵便ポストなどの色です。とても目立ち、暖かさや
