            .init(id: "meat",         title: "肉",             body: "牛や豚、鶏などから得られる食べ物です。力が出る栄養が含まれており、焼いたり
たりして食べます。",                                                                             links: ["食べ物","牛","豚","鶏","料理"]),
            .init(id: "walking",      title: "歩く",           body: "自分の足で一歩ずつ進むことです。散歩をしたり、お店に行ったり、毎日たくさん行います。",                                                                                       links: ["生活","散歩","足","靴"]),
            .init(id: "running_gen",  title: "走る",           body: "歩くよりも速いスピードで進むことです。スポーツをしたり、急いでいる時に行います。心臓がドキドキします。",                                                                   links: ["生活","スポーツ","健康","足"]),
            .init(id: "heart",        title: "心臓",           body: "体の中でドクドクと動き、血を送り出す大切なポンプです。走ったり、緊張したりすると動きが速くなります。",                                                                       links: ["生活","健康","走る","命"]),
            .init(id: "life_force",   title: "命",             body: "
ての生き物が持っている、生きている力のことです。大切に守り、育んでいくべき一番重要なものです。",                                                                           links: ["自然","生活","地球","家族","心臓"]),
            .init(id: "spring",       title: "春",             body: "冬が終わって温かくなってくる季節です。花が咲き、動物たちが
