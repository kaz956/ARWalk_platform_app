            .init(id: "road",         title: "道路",           body: "車や自転車、人が通るための平らな道です。街中を網の目のように繋ぎ、どこへでも行けるようにしてくれます。",                                                                     links: ["街","乗り物","信号","車","自転車"]),
            .init(id: "signal",       title: "信号",           body: "道路にある、進んで良いか止まるべきかを教えてくれる
