            .init(id: "blue",         title: "青",             body: "晴れた日の空や、広い海の色です。涼しさや静かさをイメージさせ、落ち着いた気持ちになります。",                                                                                 links: ["色","空","海","水"]),
            .init(id: "yellow",       title: "黄色",           body: "太陽やレモン、卵の黄身などの色です。明るくて
