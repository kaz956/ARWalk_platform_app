            .init(id: "dream",        title: "夢",             body: "寝ている間に頭の中で見る、不思議な物語や景色のことです。空を飛んだり、冒険したり、楽しい体験をすることがあります。",                                                         links: ["生活","睡眠","睡眠","遊び"]),
            .init(id: "morning",      title: "朝",             body: "一日が始まる最初の時間です。太陽が昇り、明るくなります。顔を洗って朝ごはんを食べ、学校や仕事に出かけます。",                                                                 links: ["自然","生活","太陽","朝ごはん","時計"]),
            .init(id: "night",        title: "夜",             body: "太陽が沈んで暗くなった時間です。月や星が輝き、街には明かりが灯ります。家で家族と過ごし、寝る準備をします。",                                                                 links: ["自然","生活","月","星","家"]),
            .init(id: "medicine_gen", title: "薬",             body: "体の調子が悪い時に飲む、
